# AWS Configuration
AWS_REGION=eu-central-1

# Cognito Authentication
COGNITO_DOMAIN=https://your-domain.auth.eu-central-1.amazoncognito.com
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_POOL_ID=eu-central-1_your-pool-id

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here

# DynamoDB Tables
JOBS_TABLE=jobs
USER_JOBS_TABLE=user_jobs
USERS_TABLE=users

# Job Scraping Configuration
COMPANY_NAME=DeutscheTelekomITSolutions

# Email Configuration
SES_SOURCE_EMAIL=your-email@example.com
